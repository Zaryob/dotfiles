case $- in
    *i*) ;;
    *) return ;;
esac

DOTFILES=${DOTFILES:-$HOME/.dotfiles}
# Also needed for non-login shells (Linux terminals); safe to repeat.
. "$DOTFILES/shell/env.sh"

#--------------------#
# History and shell options
#--------------------#
HISTCONTROL=ignoreboth:erasedups
HISTSIZE=50000
HISTFILESIZE=50000
shopt -s histappend checkwinsize cmdhist
# Silence the macOS "default shell is now zsh" notice.
export BASH_SILENCE_DEPRECATION_WARNING=1

#--------------------#
# Completion
#--------------------#
if ! shopt -oq posix; then
    for completion in \
        "${HOMEBREW_PREFIX:-/nonexistent}/etc/profile.d/bash_completion.sh" \
        /usr/share/bash-completion/bash_completion \
        /etc/bash_completion; do
        if [ -r "$completion" ]; then
            . "$completion"
            break
        fi
    done
    unset completion
fi

#--------------------#
# Prompt
#--------------------#
. "$DOTFILES/shell/functions.sh"
. "$DOTFILES/shell/prompt.sh"
. "$DOTFILES/shell/iterm2.sh"

#--------------------#
# Extras
#--------------------#
[ -r ~/.aliases ] && . ~/.aliases
conda_init
if command -v fzf >/dev/null && fzf --bash >/dev/null 2>&1; then
    eval "$(fzf --bash)"
fi
dotfiles_prompt_init
[ -r ~/.bashrc.local ] && . ~/.bashrc.local
true
