case $- in
    *i*) ;;
    *) return ;;
esac

DOTFILES=${DOTFILES:-$HOME/.dotfiles}
# Also needed for non-login shells (Linux terminals); safe to repeat.
. "$DOTFILES/shell/env.sh"

#--------------------#
# History and shell options
#--------------------#
HISTCONTROL=ignoreboth:erasedups
HISTSIZE=50000
HISTFILESIZE=50000
shopt -s histappend checkwinsize cmdhist
# Silence the macOS "default shell is now zsh" notice.
export BASH_SILENCE_DEPRECATION_WARNING=1

#--------------------#
# Completion
#--------------------#
if ! shopt -oq posix; then
    for completion in \
        "${HOMEBREW_PREFIX:-/nonexistent}/etc/profile.d/bash_completion.sh" \
        /usr/share/bash-completion/bash_completion \
        /etc/bash_completion; do
        if [ -r "$completion" ]; then
            . "$completion"
            break
        fi
    done
    unset completion
fi

#--------------------#
# Prompt
#--------------------#
. "$DOTFILES/shell/functions.sh"

prompt_git() {
    local branch
    branch=$(git_branch)
    [ -n "$branch" ] && printf ':%s' "$branch"
}
prompt_conda() {
    local env
    env=$(conda_env)
    [ -n "$env" ] && printf '\001\e[1;34m\002< \001\e[0;33m\002conda: \001\e[1;33m\002%s\001\e[1;34m\002 > ' "$env"
}
# Record the last exit status before the prompt's own command substitutions run.
PROMPT_COMMAND="prompt_last_status=\$?${PROMPT_COMMAND:+; $PROMPT_COMMAND}"
prompt_status() {
    [ "${prompt_last_status:-0}" -ne 0 ] && printf ' %s' "$prompt_last_status"
}
# ┌─[● host]─[user]─[dir:branch]─[time]: $
# └─╼ <conda: env> >>
PS1='\[\e[0;34m\]┌─[\[\e[1;33m\]● \h\[\e[0;34m\]]─[\[\e[1;36m\]\u\[\e[0;34m\]]─[\[\e[0;1m\]\w$(prompt_git)\[\e[0;34m\]]─\[\e[0m\][\[\e[1;33m\]\A\[\e[0m\]]\[\e[0;31m\]$(prompt_status)\[\e[0m\]: \$\n\[\e[0;34m\]└─╼ $(prompt_conda)\[\e[1;35m\]>> \[\e[0m\]'
case "$TERM" in
    xterm*|rxvt*|screen*|tmux*) PS1="\[\e]0;\u@\h: \w\a\]$PS1" ;;
esac

#--------------------#
# Extras
#--------------------#
[ -r ~/.aliases ] && . ~/.aliases
conda_init
if command -v fzf >/dev/null && fzf --bash >/dev/null 2>&1; then
    eval "$(fzf --bash)"
fi
[ -r ~/.bashrc.local ] && . ~/.bashrc.local
true
