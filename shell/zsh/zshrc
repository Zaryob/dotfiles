[[ -o interactive ]] || return

DOTFILES=${DOTFILES:-$HOME/.dotfiles}
# Also needed for non-login shells (Linux terminals); safe to repeat.
source "$DOTFILES/shell/env.sh"
typeset -U path manpath fpath

#--------------------#
# History
#--------------------#
HISTFILE=${HISTFILE:-$HOME/.zsh_history}
HISTSIZE=50000
SAVEHIST=50000
setopt extended_history share_history hist_ignore_all_dups hist_ignore_space \
       hist_reduce_blanks hist_verify

setopt auto_cd interactive_comments no_beep

#--------------------#
# Completion
#--------------------#
zsh_cache=${XDG_CACHE_HOME:-$HOME/.cache}/zsh
[[ -d $zsh_cache ]] || mkdir -p "$zsh_cache"
[[ -n ${HOMEBREW_PREFIX:-} ]] && fpath=("$HOMEBREW_PREFIX/share/zsh/site-functions" $fpath)
autoload -Uz compinit
# Full security check at most once a day; otherwise reuse the dump.
stale_dump=("$zsh_cache"/zcompdump(N.mh+24))
if (( ${#stale_dump} )) || [[ ! -s $zsh_cache/zcompdump ]]; then
    compinit -d "$zsh_cache/zcompdump"
else
    compinit -C -d "$zsh_cache/zcompdump"
fi
unset stale_dump
zstyle ':completion:*' matcher-list 'm:{a-zA-Z}={A-Za-z}'
zstyle ':completion:*' menu select
zstyle ':completion:*' use-cache on
zstyle ':completion:*' cache-path "$zsh_cache/compcache"
unset zsh_cache

#--------------------#
# Prompt
#--------------------#
source "$DOTFILES/shell/functions.sh"
autoload -Uz colors && colors
setopt prompt_subst

prompt_git() {
    local branch=$(git_branch)
    [[ -n $branch ]] && print -n ":$branch"
}
prompt_conda() {
    local env=$(conda_env)
    [[ -n $env ]] && print -n "%F{blue}<%f %F{yellow}conda%f: %B%F{yellow}$env%f%b %F{blue}>%f "
}
# ┌─[● host]─[user]─[dir:branch]─[time]: $
# └─╼ <conda: env> >>
PROMPT='%F{blue}┌─[%f%B%F{yellow}● %m%f%b%F{blue}]─[%f%B%F{green}%n%f%b%F{blue}]─[%f%B%~%b$(prompt_git)%F{blue}]─%f[%B%F{yellow}%T%f%b]%(?..%F{red} %?%f): $'$'\n''%F{blue}└─╼ %f$(prompt_conda)%B%F{magenta}>>%f%b '

#--------------------#
# Key bindings
#--------------------#
bindkey -e
# Shift+arrows select text.
shift-arrow() {
    ((REGION_ACTIVE)) || zle set-mark-command
    zle $1
}
for key kcap seq widget (
    left  LFT $'\e[1;2D' backward-char
    right RIT $'\e[1;2C' forward-char
    up    ri  $'\e[1;2A' up-line-or-history
    down  ind $'\e[1;2B' down-line-or-history
) {
    functions[shift-$key]="shift-arrow $widget"
    zle -N shift-$key
    bindkey ${terminfo[k$kcap]-$seq} shift-$key
}
unset key kcap seq widget
bindkey '^[[H'  beginning-of-line
bindkey '^[[F'  end-of-line
bindkey '^[[3~' delete-char
autoload -Uz up-line-or-beginning-search down-line-or-beginning-search
zle -N up-line-or-beginning-search
zle -N down-line-or-beginning-search
bindkey '^[[A' up-line-or-beginning-search
bindkey '^[[B' down-line-or-beginning-search

#--------------------#
# Extras
#--------------------#
[[ -r ~/.aliases ]] && source ~/.aliases
conda_init
if command -v fzf >/dev/null && fzf --zsh >/dev/null 2>&1; then
    source <(fzf --zsh)
fi
[[ -r ~/.zshrc.local ]] && source ~/.zshrc.local
true
