# Aliases shared by bash and zsh.

if ls --color=auto -d . >/dev/null 2>&1; then
    # GNU coreutils
    if command -v dircolors >/dev/null 2>&1; then
        if [ -r ~/.dircolors ]; then eval "$(dircolors -b ~/.dircolors)"; else eval "$(dircolors -b)"; fi
    fi
    alias ls='ls --color=auto'
else
    # BSD / macOS
    export CLICOLOR=1
fi
alias grep='grep --color=auto'
alias ll='ls -lh'
alias la='ls -lhA'
alias l='ls -CF'
alias ..='cd ..'
alias ...='cd ../..'

case "$(uname -s)" in
    Darwin) alias o='open' ;;
    *) command -v xdg-open >/dev/null 2>&1 && alias o='xdg-open' ;;
esac
