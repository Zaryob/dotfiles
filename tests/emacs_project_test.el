;;; emacs_project_test.el --- Project and Git integration -*- lexical-binding: t; -*-

(require 'ert)
(require 'cl-lib)
(require 'package)
(setq user-emacs-directory (getenv "DOTFILES_PROJECT_TEST_DIRECTORY")
      package-user-dir (getenv "DOTFILES_PROJECT_TEST_PACKAGES")
      use-package-always-ensure nil
      load-prefer-newer t
      gc-cons-threshold (* 32 1024 1024))
(unless (and user-emacs-directory package-user-dir)
  (error "Run through tests/emacs_project_test.sh"))
(package-initialize)
(require 'use-package)
(dolist (library '(projectile treemacs treemacs-projectile treemacs-magit magit consult diff-hl))
  (unless (locate-library (symbol-name library))
    (princ (format "SKIP: install Emacs package %s first\n" library))
    (kill-emacs 77)))
(require 'init-cmake)
(require 'init-cpp)
(require 'init-vc)
(require 'init-project)

(defun dotfiles-project-test--write (file text)
  (make-directory (file-name-directory file) t)
  (with-temp-file file (insert text)))

(defun dotfiles-project-test--git (&rest args)
  (with-temp-buffer
    (unless (zerop (apply #'process-file "git" nil t nil
                          "-c" "user.name=Emacs Test" "-c" "user.email=test@example.invalid"
                          "-c" "commit.gpgsign=false" args))
      (ert-fail (buffer-string)))))

(defmacro dotfiles-project-test--with-directory (&rest body)
  (declare (indent 0) (debug t))
  `(let* ((trial (file-truename (make-temp-file "emacs projects " t)))
          (default-directory (file-name-as-directory trial))
          (projectile-known-projects nil)
          (projectile-known-projects-file (expand-file-name "known-projects" trial))
          (projectile-project-root-cache (make-hash-table :test #'equal))
          (project-list-file (expand-file-name "project-list" trial))
          (buffers-before (buffer-list)))
     (unwind-protect
         (save-window-excursion ,@body)
       (dolist (buffer (buffer-list))
         (unless (memq buffer buffers-before)
           (with-current-buffer buffer (set-buffer-modified-p nil))
           (kill-buffer buffer)))
       (delete-directory trial t))))

(ert-deftest dotfiles-project-leader-preserves-emacs-and-cmake-keys ()
  (dolist (entry '(("M-m p p" . projectile-switch-project)
                   ("M-m p a" . projectile-add-and-switch-project)
                   ("M-m p f" . projectile-find-file)
                   ("M-m p s" . dotfiles-project-search)
                   ("M-m p t" . dotfiles-project-tree)
                   ("M-m g g" . dotfiles-git-graph)
                   ("M-m g s" . magit-status)
                   ("M-m g b" . magit-show-refs-head)
                   ("M-m c b" . dotfiles-cmake-build)
                   ("C-c p b" . dotfiles-cmake-build)
                   ("C-x C-f" . find-file)
                   ("C-SPC" . set-mark-command)))
    (should (eq (key-binding (kbd (car entry))) (cdr entry)))))

(ert-deftest dotfiles-project-discovery-and-project-el-bridge ()
  "Discover siblings at the selected depth and recognize a marked project."
  (dotfiles-project-test--with-directory
    (dotfiles-project-test--write (expand-file-name "first/.projectile" trial) "")
    (dotfiles-project-test--write (expand-file-name "second/CMakeLists.txt" trial) "")
    (dotfiles-project-test--write (expand-file-name "nested/deeper/.projectile" trial) "")
    (let ((projectile-project-search-path (list (cons trial 1))))
      (projectile-discover-projects-in-search-path))
    (should (= (length projectile-known-projects) 2))
    (let* ((root (expand-file-name "first/" trial))
           (default-directory root)
           (project (project-current nil)))
      (dotfiles-project-test--write (expand-file-name "hello.txt" root) "hello")
      (should (equal (project-root project) root))
      (should (member (expand-file-name "hello.txt" root) (project-files project))))))

(ert-deftest dotfiles-project-search-starts-at-root ()
  (dotfiles-project-test--with-directory
    (dotfiles-project-test--write (expand-file-name ".projectile" trial) "")
    (make-directory (expand-file-name "nested/src" trial) t)
    (let ((default-directory (expand-file-name "nested/src/" trial)) searched)
      (cl-letf (((symbol-function 'consult-ripgrep)
                 (lambda (directory &rest _) (setq searched directory))))
        (dotfiles-project-search))
      (should (equal searched (file-name-as-directory trial))))))

(ert-deftest dotfiles-project-switch-opens-dired-and-sidebar ()
  "Switch between two projects and toggle the actual Treemacs sidebar."
  (dotfiles-project-test--with-directory
    (let ((first (expand-file-name "first/" trial))
          (second (expand-file-name "second/" trial)))
      (dolist (root (list first second))
        (dotfiles-project-test--write (expand-file-name ".projectile" root) "")
        (dotfiles-project-test--write (expand-file-name "source.txt" root) "source\n"))
      (projectile-add-and-switch-project first)
      (should (derived-mode-p 'dired-mode))
      (should (equal default-directory first))
      (should (eq (treemacs-current-visibility) 'visible))
      (projectile-add-and-switch-project second)
      (should (equal default-directory second))
      (with-current-buffer (treemacs-get-local-buffer)
        (should (string-match-p "first" (buffer-string)))
        (should (string-match-p "second" (buffer-string))))
      (dotfiles-project-tree)
      (should-not (eq (treemacs-current-visibility) 'visible))
      (dotfiles-project-tree)
      (should (eq (treemacs-current-visibility) 'visible)))))

(ert-deftest dotfiles-git-graph-shows-branches-and-merge ()
  "Render a real branching repository through Magit, without changing it."
  (dotfiles-project-test--with-directory
    (dotfiles-project-test--git "init" "-q" "-b" "main")
    (dotfiles-project-test--write (expand-file-name "README" trial) "initial\n")
    (dotfiles-project-test--git "add" ".")
    (dotfiles-project-test--git "commit" "-qm" "initial commit")
    (dotfiles-project-test--git "checkout" "-qb" "feature")
    (dotfiles-project-test--write (expand-file-name "feature.txt" trial) "feature\n")
    (dotfiles-project-test--git "add" ".")
    (dotfiles-project-test--git "commit" "-qm" "feature work")
    (dotfiles-project-test--git "checkout" "-q" "main")
    (dotfiles-project-test--write (expand-file-name "main.txt" trial) "main\n")
    (dotfiles-project-test--git "add" ".")
    (dotfiles-project-test--git "commit" "-qm" "main work")
    (dotfiles-project-test--git "merge" "-q" "--no-ff" "-m" "merge feature" "feature")
    (with-current-buffer (dotfiles-git-graph)
      (should (derived-mode-p 'magit-log-mode))
      (should (member "--graph" magit-buffer-log-args))
      (should (equal magit-buffer-log-revisions '("--all")))
      (dolist (text '("merge feature" "feature work" "main work" "initial commit" "feature"))
        (should (string-match-p text (buffer-string))))
      (should (string-match-p "[|/]" (buffer-string))))
    (should-not (magit-anything-modified-p))))

;;; emacs_project_test.el ends here
