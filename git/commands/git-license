#!/usr/bin/env bash
# Add a LICENSE file to the current directory, or read/list the bundled licenses.
set -euo pipefail

license_dir="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}" 2>/dev/null || echo "${BASH_SOURCE[0]}")")/../share/license" && pwd)"

list() {
    ls "$license_dir"
}

license_path() {
    local path="$license_dir/$1"
    if [[ -z "$1" || "$1" == */* || ! -f "$path" ]]; then
        echo "License \"$1\" not found. Available: $(list | tr '\n' ' ')" >&2
        exit 1
    fi
    printf '%s' "$path"
}

case "${1:-}" in
    "")           echo "Usage: git license [-l|--list] [-r|--read NAME] NAME" >&2; exit 1 ;;
    -l|--list)    list ;;
    -h|--help)    exec git help license ;;
    -r|--read)    path=$(license_path "${2:-}"); "${PAGER:-less}" "$path" ;;
    *)            path=$(license_path "$1")
                  cp "$path" LICENSE
                  echo "Your repository is now licensed under \"$1\"." ;;
esac
