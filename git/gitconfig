[alias]
	# Shows list of contributors of a repository.
	contributors = shortlog --summary --numbered --email
	# Cached changes
	ccached = diff --cached
	# Takes snapshot.
	snapshot = !git stash push -m "snapshot: $(date)" && git stash apply "stash@{0}"
	# Lists snapshots.
	snapshots = !git stash list --grep snapshot
	# Uncommits last commit go back before last commit, with files in uncommitted state
	uncommit = reset --soft HEAD^
	# Unstages last changes remove files from index (tracking)
	unstage = reset HEAD
	# Optimizes git repos and removes unrelated refs
	optimize = gc --prune=now --aggressive
	# Compact history graph: hash, refs, subject, relative date, author.
	lg = log --graph --format='%C(auto)%h%d %s %C(dim)(%ar) %C(blue)<%an>%C(reset)'
	# Same, across all branches.
	lga = lg --all
	# Removes a single commit from the current branch's history: git drop <commit>
	drop = "!f() { [ $# -eq 1 ] || { echo 'usage: git drop <commit>' >&2; return 2; }; c=$(git rev-parse --verify --quiet \"$1^{commit}\") || { echo \"git drop: unknown commit: $1\" >&2; return 1; }; git merge-base --is-ancestor \"$c\" HEAD || { echo \"git drop: $1 is not on the current branch\" >&2; return 1; }; git rev-parse --verify --quiet \"$c^\" >/dev/null || { echo 'git drop: cannot drop the root commit' >&2; return 1; }; git rebase --autostash --rebase-merges --onto \"$c^\" \"$c\"; }; f"

[tag]
	forceSignAnnotated = true
[commit]
	gpgsign = true
	template = ~/.gitmessage
[core]
	excludesFile = ~/.dotfiles/git/ignore
	# Lists staged files in the commit editor; repositories' own hooks still run.
	hooksPath = ~/.dotfiles/git/hooks
	abbrev = 12
[pretty]
	fixes = Fixes: %h (\"%s\")
[pull]
	rebase = false
[init]
	defaultBranch = main
[help]
	autocorrect = prompt
[diff]
	tool = ediff

[merge]
	summary = true
	verbosity = 1
	tool = ediff

[mergetool "ediff"]
	cmd = emacs -nw \"\"  --eval \"(ediff-merge-files-with-ancestor \\\"$LOCAL\\\" \\\"$REMOTE\\\" \\\"$BASE\\\" nil \\\"$MERGED\\\")\"
	trustExitCode = true

[mergetool "ediffclient"]
	cmd = emacsclient -nw -c -a \"\"  --eval \"(ediff-merge-files-with-ancestor \\\"$LOCAL\\\" \\\"$REMOTE\\\" \\\"$BASE\\\" nil \\\"$MERGED\\\")\"
	trustExitCode = true

[difftool "ediff"]
	cmd = emacs -nw \"\"  --eval \"(ediff-files \\\"$LOCAL\\\" \\\"$REMOTE\\\")\"
	trustExitCode = true

[difftool "ediffclient"]
	cmd = emacsclient -nw -c -a \"\"  --eval \"(ediff-files \\\"$LOCAL\\\" \\\"$REMOTE\\\")\"
	trustExitCode = true

# Machine-specific overrides (optional, not tracked).
[include]
	path = ~/.gitconfig.local
