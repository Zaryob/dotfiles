[alias]
	# Shows list of contributors of a repository.
	contributors = shortlog --summary --numbered --email
	# Cached changes
	ccached = diff --cached
	# Takes snapshot.
	snapshot = !git stash push -m "snapshot: $(date)" && git stash apply "stash@{0}"
	# Lists snapshots.
	snapshots = !git stash list --grep snapshot
	# Uncommits last commit go back before last commit, with files in uncommitted state
	uncommit = reset --soft HEAD^
	# Unstages last changes remove files from index (tracking)
	unstage = reset HEAD
	# Optimizes git repos and removes unrelated refs
	optimize = gc --prune=now --aggressive

[tag]
	forceSignAnnotated = true
[commit]
	gpgsign = true
	template = ~/.gitmessage
[core]
	excludesFile = ~/.dotfiles/git/ignore
	abbrev = 12
[pretty]
	fixes = Fixes: %h (\"%s\")
[pull]
	rebase = false
[init]
	defaultBranch = main
[help]
	autocorrect = prompt
[diff]
	tool = ediff

[merge]
	summary = true
	verbosity = 1
	tool = ediff

[mergetool "ediff"]
	cmd = emacs -nw \"\"  --eval \"(ediff-merge-files-with-ancestor \\\"$LOCAL\\\" \\\"$REMOTE\\\" \\\"$BASE\\\" nil \\\"$MERGED\\\")\"
	trustExitCode = true

[mergetool "ediffclient"]
	cmd = emacsclient -nw -c -a \"\"  --eval \"(ediff-merge-files-with-ancestor \\\"$LOCAL\\\" \\\"$REMOTE\\\" \\\"$BASE\\\" nil \\\"$MERGED\\\")\"
	trustExitCode = true

[difftool "ediff"]
	cmd = emacs -nw \"\"  --eval \"(ediff-files \\\"$LOCAL\\\" \\\"$REMOTE\\\")\"
	trustExitCode = true

[difftool "ediffclient"]
	cmd = emacsclient -nw -c -a \"\"  --eval \"(ediff-files \\\"$LOCAL\\\" \\\"$REMOTE\\\")\"
	trustExitCode = true

# Machine-specific overrides (optional, not tracked).
[include]
	path = ~/.gitconfig.local
